{
  "name": "claude-code-speedometer",
  "version": "1.0.0",
  "description": "A small Claude-branded desktop widget showing your Claude Code session (5h) and weekly (7d) usage.",
  "main": "main.js",
  "author": "shajanthan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shajanthanx/code-deck.git"
  },
  "scripts": {
    "start": "electron .",
    "geticon": "node scripts/gen-appicon.js",
    "dist": "node scripts/gen-appicon.js && electron-builder --win nsis --publish never",
    "dist:portable": "node scripts/gen-appicon.js && electron-builder --win portable --publish never",
    "publish": "node scripts/gen-appicon.js && electron-builder --win nsis --publish always",
    "release": "node scripts/release.js",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.shajanthan.claudecodeusage",
    "productName": "Claude Code Usage",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "statusline/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "shajanthanx",
        "repo": "code-deck-releases",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Code Usage",
      "uninstallDisplayName": "Claude Code Usage ${version}",
      "deleteAppDataOnUninstall": false,
      "artifactName": "ClaudeCodeUsage-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ClaudeCodeUsage-${version}-portable.${ext}"
    }
  }
}
